{
  "name": "falar-app",
  "version": "1.0.0",
  "description": "App mobile de Comunicação Alternativa (CAA) para afasia pós-AVC, com SOS e área protegida para cuidadores.",
  "main": "index.ts",
  "author": "Manuela Alves",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Manuelaalvess/falar-app.git"
  },
  "keywords": [
    "react-native",
    "expo",
    "typescript",
    "firebase",
    "aac",
    "accessibility",
    "aphasia"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible": "^0.4.1",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "54.0.36",
    "expo-av": "~16.0.8",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.16.0",
    "react": "19.1.0",
    "react-hook-form": "^7.82.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "13.15.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "^3.9.5",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci",
    "validate": "npm run typecheck && npm run lint && npm test -- --ci",
    "deploy:firestore-rules": "npx firebase-tools deploy --only firestore:rules"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|firebase|@firebase))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  },
  "private": true
}
